    "OwogICAgfQp9KCkpOwo="}

on run
    -- Scripta!が実行開始時に確定したPIDを一度だけ取得し、以降の全処理で使い続ける。
    set targetPID to my requireScriptaFrontmostIllustratorPID()
    my requireTargetProcessForPID(targetPID, true)
    set actionRequest to my runEmbeddedJavaScript(targetPID)

    if actionRequest is missing value then return ""
    set actionRequest to actionRequest as text
    if actionRequest is "" then return ""

    set requestedUnits to my parseUnitRequest(actionRequest)
    my activateTargetProcess(targetPID)
    return my applyUnitPreferences(targetPID, requestedUnits)
end run

on requireScriptaFrontmostIllustratorPID()
    set pidText to system attribute "SCRIPTA_TARGET_PID"
    if pidText is "" then
        error "このスクリプトはScriptaから実行してください。SCRIPTA_TARGET_PIDがありません。"
    end if

    try
        set targetPID to pidText as integer
    on error
        error "SCRIPTA_TARGET_PIDが整数ではありません: " & pidText
    end try

    set bundleID to system attribute "SCRIPTA_TARGET_BUNDLE_ID"
    if bundleID is "" then
        error "このスクリプトはScriptaから実行してください。SCRIPTA_TARGET_BUNDLE_IDがありません。"
    end if

    if my isIllustratorBundleIdentifier(bundleID) is false then
        error "Scriptaが指定した最前面アプリはIllustratorではありません: " & bundleID
    end if

    set targetResolution to system attribute "SCRIPTA_TARGET_RESOLUTION"
    if targetResolution is not "frontmost" then
        error "Scriptaが指定したIllustratorは実行時の最前面アプリではありません。解決方法=" & targetResolution
    end if

    set targetIsActive to system attribute "SCRIPTA_TARGET_IS_ACTIVE"
    if targetIsActive is not "1" then
        set targetDisplayName to system attribute "SCRIPTA_TARGET_DISPLAY_NAME"
        error "Scriptaが指定したIllustratorは最前面ではありません: " & targetDisplayName
    end if

    return targetPID
end requireScriptaFrontmostIllustratorPID

on targetApplicationForPID(targetPID)
    set targetApplication to current application's SBApplication's applicationWithProcessIdentifier:targetPID
    if targetApplication is missing value or (targetApplication's isRunning() as boolean) is false then
        error "Illustratorへ接続できません。PID=" & targetPID
    end if

    return targetApplication
end targetApplicationForPID

on activateTargetProcess(targetPID)
    tell application "System Events"
        set matchingProcesses to every application process whose unix id is targetPID
        if (count of matchingProcesses) is 0 then
            error "対象IllustratorのUIプロセスが見つかりません。PID=" & targetPID
        end if

        set processBundleID to bundle identifier of (first application process whose unix id is targetPID) as text
        if my isIllustratorBundleIdentifier(processBundleID) is false then
            error "指定PIDのUIプロセスはIllustratorではありません。PID=" & targetPID
        end if

        set frontmost of (first application process whose unix id is targetPID) to true
    end tell

    repeat uiWaitCount times
        delay uiWaitInterval
        tell application "System Events"
            set matchingProcesses to every application process whose unix id is targetPID
            if (count of matchingProcesses) > 0 then
                if frontmost of (first application process whose unix id is targetPID) is true then return
            end if
        end tell
    end repeat

    error "対象Illustratorを最前面にできませんでした。PID=" & targetPID
end activateTargetProcess

on isIllustratorBundleIdentifier(bundleID)
    return bundleID is in illustratorBundleIdentifiers
end isIllustratorBundleIdentifier

on runEmbeddedJavaScript(targetPID)
    set targetApplication to my targetApplicationForPID(targetPID)
    set jsxSource to my embeddedJavaScript()
    set actionRequest to targetApplication's doJavascript:jsxSource withArguments:{} showDebugger:showDebuggerNever
    if actionRequest is missing value then return ""
    return actionRequest as text
end runEmbeddedJavaScript

on embeddedJavaScript()
    set encodedSource to my joinText(embeddedJSXBase64Chunks, "")
    set sourceData to current application's NSData's alloc()'s initWithBase64EncodedString:encodedSource options:0
    if sourceData is missing value then
        error "埋め込みJSXを復元できません。"
    end if

    set sourceString to current application's NSString's alloc()'s initWithData:sourceData encoding:(current application's NSUTF8StringEncoding)
    if sourceString is missing value then
        error "埋め込みJSXをUTF-8として読み込めません。"
    end if

    return sourceString as text
end embeddedJavaScript

on parseUnitRequest(actionRequest)
    set requestFields to my splitText(actionRequest, "|")
    if (count of requestFields) is not 6 then
        error "単位変更要求のフィールド数が正しくありません: " & actionRequest
    end if

    if (item 1 of requestFields as text) is not postActionProtocol then
        error "不明な後処理プロトコルです: " & item 1 of requestFields
    end if

    if (item 2 of requestFields as text) is not postActionName then
        error "許可されていない後処理です: " & item 2 of requestFields
    end if

    set generalUnit to my requireAllowedUnit(item 3 of requestFields as text, {"mm", "pt", "px"}, "一般")
    set strokeUnit to my requireAllowedUnit(item 4 of requestFields as text, {"mm", "pt", "px"}, "線")
    set textUnit to my requireAllowedUnit(item 5 of requestFields as text, {"q", "pt", "px"}, "文字")
    set asianUnit to my requireAllowedUnit(item 6 of requestFields as text, {"h", "pt", "px"}, "東アジア言語")

    return {generalUnit, strokeUnit, textUnit, asianUnit}
end parseUnitRequest

on requireAllowedUnit(unitIdentifier, allowedUnits, fieldName)
    if unitIdentifier is not in allowedUnits then
        error fieldName & "の単位識別子は許可されていません: " & unitIdentifier
    end if
    return unitIdentifier
end requireAllowedUnit

on applyUnitPreferences(targetPID, requestedUnits)
    set targetLabels to {}
    repeat with requestedUnit in requestedUnits
        set end of targetLabels to my canonicalUnitLabel(requestedUnit as text)
    end repeat

    try
        my requireTargetProcessForPID(targetPID, true)
        my openUnitsPreferences(targetPID)

        repeat with comboBoxIndex from 1 to 4
            set targetLabel to item comboBoxIndex of targetLabels
            my selectUnit(targetPID, comboBoxIndex, targetLabel)
        end repeat

        set finalValues to my readComboBoxValues(targetPID, targetLabels)
        if finalValues is not targetLabels then
            error "単位の変更結果が指定値と一致しません。現在値: " & my joinText(finalValues, ", ")
        end if

        my clickOKAndWait(targetPID)

        return "一般=" & item 1 of finalValues & linefeed & ¬
            "線=" & item 2 of finalValues & linefeed & ¬
            "文字=" & item 3 of finalValues & linefeed & ¬
            "東アジア言語=" & item 4 of finalValues
    on error errorMessage number errorNumber
        my cancelUnitPreferences(targetPID)
        error errorMessage number errorNumber
    end try
end applyUnitPreferences

on requireTargetProcessForPID(targetPID, requireFrontmost)
    -- 複数バージョンは同じプロセス名を持つため、名前や保持したUI参照では再解決しない。
    tell application "System Events"
        set matchingProcesses to every application process whose unix id is targetPID
        if (count of matchingProcesses) is 0 then
            error "対象IllustratorのUIプロセスが見つかりません。PID=" & targetPID
        end if

        set processBundleID to bundle identifier of (first application process whose unix id is targetPID) as text
        set processIsFrontmost to frontmost of (first application process whose unix id is targetPID)
    end tell

    if my isIllustratorBundleIdentifier(processBundleID) is false then
        error "指定PIDのUIプロセスはIllustratorではありません。PID=" & targetPID
    end if

    if requireFrontmost and processIsFrontmost is false then
        error "対象Illustratorが最前面ではありません。PID=" & targetPID
    end if
end requireTargetProcessForPID

on unitPreferencesAreaIndex(targetPID)
    tell application "System Events"
        if (count of (every application process whose unix id is targetPID)) is 0 then return 0

        tell (first application process whose unix id is targetPID)
            set topLevelElementCount to count of UI elements
            repeat with elementIndex from 1 to topLevelElementCount
                if role of UI element elementIndex is "AXLayoutArea" then
                    if (count of combo boxes of UI element elementIndex) is 4 then return elementIndex
                end if
            end repeat
        end tell
    end tell

    return 0
end unitPreferencesAreaIndex

on openUnitsPreferences(targetPID)
    my requireTargetProcessForPID(targetPID, true)

    if my unitPreferencesAreaIndex(targetPID) > 0 then return

    tell application "System Events"
        tell (first application process whose unix id is targetPID)
            click menu bar item "Illustrator" of menu bar 1
            delay 0.2
            click menu item "単位..." of menu 1 of menu item "設定…" of menu 1 of menu bar item "Illustrator" of menu bar 1
        end tell
    end tell

    repeat uiWaitCount times
        delay uiWaitInterval
        if my unitPreferencesAreaIndex(targetPID) > 0 then return
    end repeat

    error "Illustratorの「環境設定 ＞ 単位」を開けませんでした。"
end openUnitsPreferences

on selectUnit(targetPID, comboBoxIndex, targetLabel)
    set targetLabel to targetLabel as text
    my requireTargetProcessForPID(targetPID, true)
    set preferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
    if preferencesAreaIndex is 0 then
        error "対象Illustratorの環境設定が見つかりません。PID=" & targetPID
    end if

    tell application "System Events"
        tell (first application process whose unix id is targetPID)
            set currentValue to value of combo box comboBoxIndex of UI element preferencesAreaIndex
            set embeddedChoiceCount to count of UI elements of combo box comboBoxIndex of UI element preferencesAreaIndex
        end tell
    end tell

    if currentValue is not missing value then
        set currentValueText to currentValue as text
        if currentValueText is targetLabel then return
    end if

    set usesEmbeddedChoices to currentValue is missing value and embeddedChoiceCount > 0
    if usesEmbeddedChoices then
        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                set choices to description of every UI element of combo box comboBoxIndex of UI element preferencesAreaIndex
            end tell
        end tell
    else
        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                perform action "AXPress" of combo box comboBoxIndex of UI element preferencesAreaIndex
            end tell
        end tell
        set choices to my waitForUnitPopupChoices(targetPID, preferencesAreaIndex)
    end if

    set targetIndex to my indexOfText(targetLabel, choices)
    if targetIndex is 0 then
        error "comboBox" & comboBoxIndex & " に「" & targetLabel & "」がありません。候補: " & my joinText(choices, ", ")
    end if

    if usesEmbeddedChoices then
        my clickComboBoxAtCoordinates(targetPID, preferencesAreaIndex, comboBoxIndex)
    end if

    my chooseUnitByKeyboard(targetPID, targetIndex)

    if usesEmbeddedChoices then
        -- Illustrator 2024はAXValueを公開しないため、決定キー送信までを成功条件とする。
        delay uiWaitInterval
        return
    end if

    repeat uiWaitCount times
        delay uiWaitInterval
        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                set currentPreferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
                if currentPreferencesAreaIndex is 0 then
                    error "単位選択中に対象Illustratorの環境設定が見つからなくなりました。PID=" & targetPID
                end if
                set currentValueText to value of combo box comboBoxIndex of UI element currentPreferencesAreaIndex as text
            end tell
        end tell
        if currentValueText is targetLabel then return
    end repeat

    error "comboBox" & comboBoxIndex & " を「" & targetLabel & "」に変更できませんでした。"
end selectUnit

on clickComboBoxAtCoordinates(targetPID, preferencesAreaIndex, comboBoxIndex)
    my requireTargetProcessForPID(targetPID, true)

    tell application "System Events"
        tell (first application process whose unix id is targetPID)
            set comboPosition to position of combo box comboBoxIndex of UI element preferencesAreaIndex
            set comboSize to size of combo box comboBoxIndex of UI element preferencesAreaIndex
        end tell

        set clickX to (item 1 of comboPosition) + (item 1 of comboSize) - 10
        set clickY to (item 2 of comboPosition) + ((item 2 of comboSize) div 2)
        set frontmost of (first application process whose unix id is targetPID) to true
        click at {clickX, clickY}
    end tell

    delay uiWaitInterval
end clickComboBoxAtCoordinates

on chooseUnitByKeyboard(targetPID, targetIndex)
    my requireTargetProcessForPID(targetPID, true)

    tell application "System Events"
        if frontmost of (first application process whose unix id is targetPID) is false then
            error "単位選択中に対象Illustratorが最前面ではなくなりました。PID=" & targetPID
        end if
        key code 115
        repeat (targetIndex - 1) times
            key code 125
        end repeat
        key code 36
    end tell
end chooseUnitByKeyboard

on waitForUnitPopupChoices(targetPID, preferencesAreaIndex)
    repeat uiWaitCount times
        delay uiWaitInterval

        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                set topLevelElementCount to count of UI elements
                repeat with elementIndex from 1 to topLevelElementCount
                    if elementIndex is not preferencesAreaIndex and role of UI element elementIndex is "AXLayoutArea" then
                        try
                            set choices to description of every static text of UI element elementIndex
                            if (count of choices) > 0 then return choices
                        end try
                    end if
                end repeat
            end tell
        end tell
    end repeat

    error "単位の候補一覧を開けませんでした。"
end waitForUnitPopupChoices

on readComboBoxValues(targetPID, fallbackValues)
    my requireTargetProcessForPID(targetPID, true)
    set preferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
    if preferencesAreaIndex is 0 then
        error "対象Illustratorの環境設定が見つかりません。PID=" & targetPID
    end if

    set currentValues to {}
    repeat with comboBoxIndex from 1 to 4
        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                set currentValue to value of combo box comboBoxIndex of UI element preferencesAreaIndex
            end tell
        end tell

        if currentValue is missing value then
            set end of currentValues to item comboBoxIndex of fallbackValues as text
        else
            set end of currentValues to currentValue as text
        end if
    end repeat

    return currentValues
end readComboBoxValues

on clickOKAndWait(targetPID)
    my requireTargetProcessForPID(targetPID, true)
    set preferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
    if preferencesAreaIndex is 0 then
        error "対象Illustratorの環境設定が見つかりません。PID=" & targetPID
    end if

    tell application "System Events"
        tell (first application process whose unix id is targetPID)
            set okButtonCount to count of (every button of UI element preferencesAreaIndex whose description is "OK")
            if okButtonCount is 0 then error "環境設定のOKボタンが見つかりません。"
            click first button of UI element preferencesAreaIndex whose description is "OK"
        end tell
    end tell

    repeat uiWaitCount times
        delay uiWaitInterval
        if my unitPreferencesAreaIndex(targetPID) is 0 then return
    end repeat

    error "OKを押しましたが、環境設定が閉じませんでした。"
end clickOKAndWait

on cancelUnitPreferences(targetPID)
    try
        set preferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
        if preferencesAreaIndex is 0 then return

        tell application "System Events"
            tell (first application process whose unix id is targetPID)
                set layoutAreaCount to count of (every UI element whose role is "AXLayoutArea")
            end tell

            if layoutAreaCount > 1 and frontmost of (first application process whose unix id is targetPID) is true then
                key code 53
                delay uiWaitInterval
            end if

            set preferencesAreaIndex to my unitPreferencesAreaIndex(targetPID)
            if preferencesAreaIndex is 0 then return
            tell (first application process whose unix id is targetPID)
                set cancelButtonCount to count of (every button of UI element preferencesAreaIndex whose description is "キャンセル")
                if cancelButtonCount > 0 then click first button of UI element preferencesAreaIndex whose description is "キャンセル"
            end tell
        end tell
    end try
end cancelUnitPreferences

on canonicalUnitLabel(unitIdentifier)
    if unitIdentifier is "mm" then return "ミリメートル"
    if unitIdentifier is "pt" then return "ポイント"
    if unitIdentifier is "px" then return "ピクセル"
    if unitIdentifier is "q" then return "級"
    if unitIdentifier is "h" then return "歯"
    error "表示名へ変換できない単位識別子です: " & unitIdentifier
end canonicalUnitLabel

on indexOfText(targetText, textList)
    repeat with itemIndex from 1 to count of textList
        if (item itemIndex of textList as text) is targetText then return itemIndex
    end repeat
    return 0
end indexOfText

on splitText(sourceText, delimiterText)
    set previousDelimiters to AppleScript's text item delimiters
    try
        set AppleScript's text item delimiters to delimiterText
        set resultItems to text items of sourceText
        set AppleScript's text item delimiters to previousDelimiters
        return resultItems
    on error errorMessage number errorNumber
        set AppleScript's text item delimiters to previousDelimiters
        error errorMessage number errorNumber
    end try
end splitText

on joinText(textList, separatorText)
    set previousDelimiters to AppleScript's text item delimiters
    try
        set AppleScript's text item delimiters to separatorText
        set joinedText to textList as text
        set AppleScript's text item delimiters to previousDelimiters
        return joinedText
    on error errorMessage number errorNumber
        set AppleScript's text item delimiters to previousDelimiters
        error errorMessage number errorNumber
    end try
end joinText
